---
import { fmtInt, fmtRating } from '../lib/load.mjs';
const { rating, reviews } = Astro.props;
const full = Math.round(rating);
---
{reviews > 0 ? (
  <p class="rating"><span class="stars" aria-hidden="true">{'★'.repeat(full)}{'☆'.repeat(5 - full)}</span><span class="score">{fmtRating(rating)}</span><span class="meta">{`(${fmtInt(reviews)} ${reviews === 1 ? 'Bewertung' : 'Bewertungen'} bei Google)`}</span></p>
) : (
  <p class="meta">Noch keine Bewertungen</p>
)}
