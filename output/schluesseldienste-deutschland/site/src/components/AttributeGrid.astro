---
// Nur bestätigte Leistungen (wiki/framework/enrichment.md). Ein Merkmal erscheint genau dann, wenn
// die Website des Betriebs es belegt (Wert "true"). Nicht bestätigte Merkmale werden weggelassen,
// nicht benannt: weder ein "nein" noch eine "Keine Angaben"-Zeile. Ist nichts bestätigt, gibt die
// Komponente nichts aus, und die Eintragsseite lässt den ganzen Abschnitt weg. Das Wort "Ja" bleibt
// unsichtbar für Vorleseprogramm und Suchmaschine erhalten.
const { attrs } = Astro.props;
const yes = attrs.filter((a) => a.value === 'true');
---
{yes.length > 0 && (
  <ul class="attr-grid">
    {yes.map((a) => (
      <li class="yes">
        <h3>{a.label}</h3>
        <span class="v true"><svg class="check" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor" /><path d="M6.8 12.6l3.4 3.4 7-7.6" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="sr-only">Ja</span></span>
      </li>
    ))}
  </ul>
)}
