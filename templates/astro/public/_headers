# Kopfzeilen für Cloudflare Pages. https://developers.cloudflare.com/pages/configuration/headers/

# Die kostenlose Adresse auf pages.dev liefert dieselben Seiten wie die eigene Domain. Sie bleibt
# aus der Suche, damit das Verzeichnis nur unter einer Adresse indexiert wird.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Schriften und Stylesheet tragen einen Hash im Dateinamen und können ein Jahr zwischengespeichert werden.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
