---
// Leistungsseiten: /leistungen/ (das Verzeichnis) und /leistungen/<slug>/, eine je Merkmal mit einem
// `service`-Block in attributes.json, das mindestens die Mindestzahl an Einträgen bestätigt
// (wiki/framework/page-types.md). Landesweite Antwort auf "<Leistung> Schlüsseldienst in Deutschland".
// Ohne service-Blöcke baut diese Route nichts.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import ClaimCta from '../../components/ClaimCta.astro';
import { loadDirectory, paragraphs, e164, businessType, fmtInt } from '../../lib/load.mjs';
export function getStaticPaths() {
  const { services } = loadDirectory();
  if (!services.length) return [];
  return [{ params: { slug: undefined }, props: { key: '' } }, ...services.map((s) => ({ params: { slug: s.slug }, props: { key: s.key } }))];
}
const { key } = Astro.props;
const dir = loadDirectory();
const { site, services, listings, countryPath, buildDate, buildDateDe } = dir;
const s = services.find((x) => x.key === key);
const base = `https://${site.domain}`;
const path = s ? s.path : '/leistungen/';
const title = s ? `${s.title} in ${site.country.name} (${fmtInt(s.count)} eingetragen) | ${site.brand}` : `${site.niche.title} in ${site.country.name} nach Leistung | ${site.brand}`;
const top = s ? s.listings.find((l) => l.reviews > 0) : null;
const description = s
  ? `${fmtInt(s.count)} ${site.niche.plural} in ${site.country.name}, die „${s.label}“ anbieten, in ${fmtInt(s.cities.length)} ${s.cities.length === 1 ? 'Stadt' : 'Städten'}.${top ? ` Am besten bewertet: ${top.name}.` : ''}`
  : `${site.niche.title} in ${site.country.name}, geordnet nach den Leistungen, die sie bestätigen: ${services.slice(0, 4).map((x) => x.label).join(', ')} und weitere.`;
const cards = s ? s.listings.slice(0, site.maxCardsPerCity || 60) : [];
const intro = s && s.intro.length ? s.intro : s ? [
  `${fmtInt(s.count)} der ${fmtInt(listings.length)} in ${site.country.name} eingetragenen ${site.niche.plural} nennen „${s.label}“ als Leistung, verteilt auf ${fmtInt(s.cities.length)} ${s.cities.length === 1 ? 'Stadt' : 'Städte'}. Die Liste ist nach der Google-Bewertung geordnet, gewichtet mit der Anzahl der Bewertungen. Lassen Sie sich die Einzelheiten vor der Beauftragung bestätigen.`,
] : [];
const schema = s ? [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': base + path, url: base + path, name: title, inLanguage: 'de-DE', datePublished: site.launchDate, dateModified: buildDate },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `${s.title} in ${site.country.name}`, numberOfItems: s.count,
    itemListElement: cards.map((l, i) => ({ '@type': 'ListItem', position: i + 1, item: {
      '@type': businessType(site), '@id': `${base}${l.path}#business`, name: l.name, url: base + l.path, telephone: e164(l.phone),
      address: { '@type': 'PostalAddress', addressLocality: l.city, addressRegion: l.regionName, postalCode: l.postalCode || undefined, addressCountry: 'DE' },
    } })) },
] : [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': base + path, url: base + path, name: title, inLanguage: 'de-DE', datePublished: site.launchDate, dateModified: buildDate },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `${site.niche.title} in ${site.country.name} nach Leistung`,
    itemListElement: services.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: base + x.path, name: x.title })) },
];
const crumbs = [{ name: 'Startseite', href: '/' }, { name: 'Leistungen', href: '/leistungen/' }, ...(s ? [{ name: s.title, href: s.path }] : [])];
---
<Base title={title} description={description} path={path} schema={schema}>
  <Fragment slot="head">
    <Breadcrumbs site={site} items={crumbs} />
    <h1>{s ? `${s.title} in ${site.country.name}` : `${site.niche.title} in ${site.country.name}, nach Leistung`}</h1>
    {s ? (
      <ul class="keyfacts">
        <li><b>{fmtInt(s.count)}</b>eingetragen</li>
        <li><b>{fmtInt(s.cities.length)}</b>{s.cities.length === 1 ? 'Stadt' : 'Städte'}</li>
        <li>Stand {buildDateDe}</li>
      </ul>
    ) : <p class="lede">Jede Seite führt die {site.niche.plural} auf, die eine Leistung bestätigen, geordnet nach Bewertung und Anzahl der Bewertungen.</p>}
  </Fragment>

  {s ? (
    <>
      <div class="prose" set:html={paragraphs(intro)}></div>
      <section>
        <h2>{cards.length < s.count ? `Die ${cards.length} bestbewerteten von ${fmtInt(s.count)}` : `Alle ${fmtInt(s.count)}`}: {s.label}</h2>
        <!-- copy:skip -->
        <div class="grid">{cards.map((l) => <Card l={l} />)}</div>
        <!-- /copy:skip -->
      </section>
      <section>
        <h2>{s.title} nach Stadt</h2>
        <p class="meta">So viele der eingetragenen {site.niche.plural} nennen „{s.label}“ auf der jeweiligen Stadtseite.</p>
        <!-- copy:skip -->
        <ul class="city-grid">{s.cities.map((x) => <li><a href={x.city.path}><span class="name">{x.city.name}</span> <span class="n">{x.count}</span></a></li>)}</ul>
        <!-- /copy:skip -->
      </section>
      {services.length > 1 && (
        <section>
          <h2>Weitere Leistungen</h2>
          <!-- copy:skip -->
          <ul class="city-grid svc-grid">{services.filter((x) => x !== s).map((x) => <li><a href={x.path}><span class="name">{x.title}</span> <span class="n">{fmtInt(x.count)}</span></a></li>)}</ul>
          <!-- /copy:skip -->
        </section>
      )}
    </>
  ) : (
    <section>
      <ul class="city-grid svc-grid">{services.map((x) => <li><a href={x.path}><span class="name">{x.title}</span> <span class="n">{fmtInt(x.count)}</span></a></li>)}</ul>
      <p class="meta"><a href={countryPath}>Oder nach Bundesland und Stadt blättern</a>.</p>
    </section>
  )}
  <ClaimCta site={site} />
</Base>
